        "#| label: load-pkgs\n",
        "# imports\n",
        "\n",
        "# Vera\n",
        "# in addition to Molly's\n",
        "import seaborn as sns\n",
        "import glob\n",
        "import os\n",
        "from matplotlib.dates import date2num\n",
        "\n",
        "# Molly\n",
        "import geopandas as gpd\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import shapely\n",
        "\n",
        "# Brooke\n"
      ],
      "id": "load-pkgs",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Data Validation & Cleaning\n"
      ],
      "id": "86aaa030"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Vera section\n",
        "\n",
        "# load data\n",
        "\n",
        "all_files = glob.glob(\"data/NOAA/\" + \"*.csv\")\n",
        "\n",
        "list_of_dfs = []\n",
        "\n",
        "for file in all_files:\n",
        "  df = pd.read_csv(file)\n",
        "  list_of_dfs.append(df)\n",
        "\n",
        "# merging data together into one data frame\n",
        "noaa = pd.concat(list_of_dfs, ignore_index = True)\n",
        "\n",
        "# make copy\n",
        "noaa1 = noaa\n",
        "\n",
        "# dropping unnecessary data\n",
        "noaa1.info()\n",
        "\n",
        "# dropping columns that have too low non-null count (cannot extract valuable estimates from to fill null values)\n",
        "noaa1 = noaa1.drop(['DAPR', 'DASF', 'MDSF', 'PGTM', 'WDF2', 'WDF5', 'WESD', 'WESF'], axis = 1)\n"
      ],
      "id": "f00e08eb",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Vera\n",
        "\n",
        "# investigate missing values\n",
        "\n",
        "print(\"Missing values (NaN): \\n\" + str(noaa1.isnull().sum()))\n",
        "\n",
        "unique_stations = noaa1['STATION'].unique()\n",
        "\n",
        "\n",
        "station_count = noaa1['STATION'].value_counts()\n",
        "\n",
        "\n",
        "print(\"Stations: \" + str(unique_stations))\n",
        "print(\"Station count: \" + str(station_count))\n",
        "\n",
        "# group by station\n",
        "noaaNum = noaa1.select_dtypes(include = np.number)\n",
        "\n",
        "print(noaaNum)\n",
        "\n",
        "# For all values in the numerical column list from above\n",
        "for col in noaaNum.columns:\n",
        "    noaa1[col] = noaa1[col].fillna(\n",
        "        noaa1.groupby('STATION')[col].transform('median')\n",
        "    )\n",
        "\n",
        "print(\"Missing values NOW (NaN): \\n\" + str(noaa1.isnull().sum()))"
      ],
      "id": "0d1e2355",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# visualizations of all features\n",
        "\n",
        "# date is in correct time format\n",
        "noaa1['DATE'] = pd.to_datetime(noaa1['DATE'])\n",
        "\n",
        "# selecting variables to plot\n",
        "noaa1_scatter_eda = noaa1[['DATE', 'AWND', 'EVAP', 'PRCP', 'SNOW', 'SNWD', 'TAVG', 'TMAX', 'TMIN', 'TOBS', 'WSF2', 'WSF5']]\n",
        "\n",
        "# numeric columns\n",
        "num_cols = noaa1_scatter_eda.select_dtypes(include=np.number).columns\n",
        "\n",
        "# create stacked subplots\n",
        "fig, axes = plt.subplots(len(num_cols), 1, figsize=(12, 3 * len(num_cols)), sharex=True)\n",
        "\n",
        "# for loop to plot all figures into grid\n",
        "for i, col in enumerate(num_cols):\n",
        "    # Scatter plot\n",
        "    sns.scatterplot(\n",
        "        data=noaa1_scatter_eda, x=\"DATE\", y=col,\n",
        "        ax=axes[i], s=5, alpha=0.5, color=\"blue\", edgecolor=None)\n",
        "    \n",
        "    axes[i].set_ylabel(col)\n",
        "    axes[i].grid(True, linestyle='--', alpha=0.5)\n",
        "\n",
        "axes[-1].set_xlabel(\"Date\")\n",
        "\n",
        "fig.tight_layout()\n",
        "plt.show()"
      ],
      "id": "98345e5c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Molly section\n",
        "\n",
        "# grid construction reference: https://james-brennan.github.io/posts/fast_gridding_geopandas/\n",
        "\n",
        "def grid_bin(df, proj='EPSG:4326'):\n",
        "  # take in df with features \"latitude\" (ranging 31 to 37) and \"longitude\" (ranging -109 to -115) and return geodataframe with a new column that is the grid number\n",
        "\n",
        "  # Create geometry feature of input df\n",
        "  df['geometry'] = gpd.points_from_xy(df.longitude, df.latitude,\n",
        "    crs=proj)\n",
        "  gdf = gpd.GeoDataFrame(data=df, geometry='geometry')\n",
        "\n",
        "  # Initialize grid dataframe\n",
        "  xmin = -114.5   # total area for the grid with ranging values\n",
        "  ymin = 31.2     # describing latitude and longitude limits for AZ\n",
        "  xmax = -109\n",
        "  ymax = 37\n",
        "\n",
        "  num_x = 15  # how many cells in x direction minus 1\n",
        "  num_y = 20  # how many cells in y direction minus 1\n",
        "              # total cells is num_x*num_y (336 in our case)\n",
        "\n",
        "  cell_size_x = (xmax-xmin)/num_x   # how many cells across and down\n",
        "  cell_size_y = (ymax-ymin)/num_y\n",
        "\n",
        "  # projection of the grid\n",
        "  crs = proj\n",
        "\n",
        "  grid_cells = []\n",
        "  for x0 in np.arange(xmin, xmax+cell_size_x, cell_size_x ):\n",
        "      for y0 in np.arange(ymin, ymax+cell_size_y, cell_size_y):\n",
        "          # bounds\n",
        "          x1 = x0-cell_size_x\n",
        "          y1 = y0+cell_size_y\n",
        "          grid_cells.append( shapely.geometry.box(x0, y0, x1, y1)  )\n",
        "\n",
        "  grid = gpd.GeoDataFrame(grid_cells, columns=['geometry'], \n",
        "                                 crs=crs)\n",
        "\n",
        "  # print(grid.shape)   # axis 0 is the number of cells in the grid\n",
        "\n",
        "  # Spatially join (sjoin) input df and grid\n",
        "  gdf_joined = gpd.sjoin(left_df=gdf, right_df=grid, how='left')\n",
        "\n",
        "  # Rename column to be more intuitive\n",
        "  gdf_joined['gridspace'] = gdf_joined['index_right']\n",
        "  gdf_joined = gdf_joined.drop(['index_right'], axis=1)\n",
        "\n",
        "  return gdf_joined\n",
        "\n",
        "\n",
        "# Group station data and counts data\n",
        "# Read in counts data\n",
        "traffic_dfs = {}\n",
        "# hours = [\"Hour_{:02}\".format(x) for x in range(24)]\n",
        "# print(hours)\n",
        "\n",
        "for i in range(19, 24):   # for year of interest\n",
        "  year = \"{:02}\".format(i)\n",
        "  yearnum = int(f'20{year}')\n",
        "\n",
        "  # read in station data\n",
        "  df_year = pd.read_csv(f'data/Traffic/stations/df_20{year}')   \n",
        "  df_year['station_annual_count'] = 0    # make new column of zeros\n",
        "\n",
        "  for j in range(1,13):   # for month of interest\n",
        "    monthyear = \"{:02}\".format(j) + year\n",
        "\n",
        "    # read in counts data\n",
        "    df_month = pd.read_csv(f\"data/Traffic/counts/AZ{monthyear}.VOL\")\n",
        "    df_month = df_month.rename(columns = {'Station_Id':'station_id'}) # so we have common column for merging\n",
        "    df_month['daily_volume'] = df_month[[\"Hour_{:02}\".format(i) for i in range(24)]].sum(axis=1) # sum hour counts to daily count\n",
        "    df_month = df_month.groupby('station_id')[['daily_volume']].sum() # monthly sum per station\n",
        "\n",
        "    # df_volumes = df_volumes.drop([\"Hour_{:02}\".format(i) for i in range(24)], axis=1)\n",
        "\n",
        "  traffic_dfs[yearnum] = df_year\n",
        "    # traffic_dfs[yearnum]['station_annual_count'] += np.log(df_volumes['daily_volume'])\n",
        "    \n",
        "    # test aggregating count data\n",
        "\n",
        "\n",
        "df_2023 = pd.read_csv('data/Traffic/stations/df_2023')\n",
        "\n",
        "# Ref: https://saturncloud.io/blog/how-to-sum-two-columns-in-a-pandas-dataframe/\n",
        "\n",
        "\n",
        "df_count = pd.read_csv('data/Traffic/counts/AZ1019.VOL')\n",
        "print(df_count.columns)\n",
        "print(df_count.info())\n",
        "\n",
        "# The following is an example of how we will combine hourly counts into a sum over each day\n",
        "\n",
        "# df_2023\n",
