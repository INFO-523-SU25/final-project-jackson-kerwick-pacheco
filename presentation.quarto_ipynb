        "---\n",
        "title: \"Urbanization and Climate in Arizona, USA\"\n",
        "subtitle: \"INFO 523 - Summer 2025 - Final Project\"\n",
        "author: \"Vera Jackson, Molly Kerwick, Brooke Pacheco\"\n",
        "title-slide-attributes:\n",
        "  data-background-image: images/az_traffic.webp\n",
        "  data-background-size: stretch\n",
        "  data-background-opacity: \"0.3\"\n",
        "  data-slide-number: none\n",
        "format:\n",
